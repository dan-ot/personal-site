---
import { icon } from '@fortawesome/fontawesome-svg-core';
import { faChevronDown } from '@fortawesome/free-solid-svg-icons';

const chevronDown = icon(faChevronDown, { classes: ['h-3', 'w-3'] }).html.join('');
const currentPath = Astro.url.pathname;

const isActive = (path: string) => currentPath === path || currentPath.startsWith(`${path}/`);
---

<header class="sticky top-0 z-10 border-b border-white/10 bg-slate-950/80 backdrop-blur">
  <nav class="mx-auto flex max-w-5xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
    <a href="/" class="text-lg font-semibold tracking-wide text-white">Dan Qu</a>
    <ul class="flex items-center gap-2 text-sm sm:gap-4">
      <li class="relative group">
        <button
          class={`inline-flex items-center gap-2 rounded-md px-3 py-2 transition ${
            isActive('/about') || isActive('/resume')
              ? 'bg-cyan-400/20 text-cyan-200'
              : 'text-slate-200 hover:bg-white/10'
          }`}
          aria-haspopup="true"
          aria-expanded="false"
        >
          Personal
          <span set:html={chevronDown} />
        </button>
        <ul class="invisible absolute right-0 mt-1 w-36 rounded-lg border border-white/10 bg-slate-900/95 p-1 opacity-0 shadow-lg transition group-focus-within:visible group-focus-within:opacity-100 group-hover:visible group-hover:opacity-100">
          <li>
            <a href="/about" class={`block rounded px-3 py-2 ${isActive('/about') ? 'bg-cyan-400/20 text-cyan-200' : 'text-slate-200 hover:bg-white/10'}`}>About</a>
          </li>
          <li>
            <a href="/resume" class={`block rounded px-3 py-2 ${isActive('/resume') ? 'bg-cyan-400/20 text-cyan-200' : 'text-slate-200 hover:bg-white/10'}`}>Resume</a>
          </li>
        </ul>
      </li>
      <li>
        <a href="/projects" class={`rounded-md px-3 py-2 transition ${isActive('/projects') ? 'bg-cyan-400/20 text-cyan-200' : 'text-slate-200 hover:bg-white/10'}`}>Projects</a>
      </li>
      <li>
        <a href="/blog" class={`rounded-md px-3 py-2 transition ${isActive('/blog') ? 'bg-cyan-400/20 text-cyan-200' : 'text-slate-200 hover:bg-white/10'}`}>Blog</a>
      </li>
    </ul>
  </nav>
</header>
