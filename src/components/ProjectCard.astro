---
interface Props {
  title: string;
  description: string;
  slug: string;
  repoUrl: string;
  tags: string[];
}

const { title, description, slug, repoUrl, tags } = Astro.props;
---

<article class="card-surface rounded-xl p-5">
  <h3 class="text-lg font-semibold text-white">
    <a href={`/projects/${slug}`} class="hover:text-cyan-200">{title}</a>
  </h3>
  <p class="mt-2 text-sm text-slate-300">{description}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {tags.map((tag) => <span class="rounded-full bg-white/10 px-2 py-1 text-xs text-slate-200">{tag}</span>)}
  </div>
  <p class="mt-4 text-sm">
    <a href={repoUrl} target="_blank" rel="noreferrer" class="text-cyan-200 hover:text-cyan-100">View repository</a>
  </p>
</article>
