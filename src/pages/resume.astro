---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const entry = await getEntry('personal', 'resume');

if (!entry) {
  throw new Error('Missing personal/resume.mdx content entry.');
}

const { Content } = await render(entry);
---

<BaseLayout title="Resume | Dan Qu" description="Professional resume and experience.">
  <article class="prose prose-invert max-w-none">
    <Content />
  </article>
</BaseLayout>
